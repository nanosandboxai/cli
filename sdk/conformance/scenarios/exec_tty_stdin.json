{
  "id": "exec_tty_stdin",
  "description": "tty exec_stream with live stdin and resize frames",
  "capabilities": ["exec", "exec_pty"],
  "steps": [
    {
      "expect": { "type": "exec_stream", "name": "box", "command": "cat", "tty": true },
      "respond": [
        { "type": "ok", "version": "1.0.0" },
        { "type": "guest", "event": "stdout", "data": "echo" },
        { "type": "guest", "event": "exit", "code": 0 }
      ]
    },
    {
      "expect": { "type": "exec_input", "data": "ls\n" },
      "respond": { "type": "ok", "version": "1.0.0" }
    },
    {
      "expect": { "type": "exec_resize", "cols": 120, "rows": 40 },
      "respond": { "type": "ok", "version": "1.0.0" }
    }
  ],
  "assert": {
    "exit_code": 0,
    "stdout_contains": ["echo"],
    "input_acked": true,
    "resize_acked": true
  }
}
