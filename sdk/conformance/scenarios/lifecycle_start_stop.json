{
  "id": "lifecycle_start_stop",
  "description": "start then stop a sandbox",
  "capabilities": ["lifecycle"],
  "steps": [
    {
      "expect": { "type": "start", "name": "box" },
      "respond": { "type": "ok", "version": "1.0.0" }
    },
    {
      "expect": { "type": "stop", "name": "box", "force": false },
      "respond": { "type": "ok", "version": "1.0.0" }
    }
  ],
  "assert": {
    "start_acked": true,
    "stop_acked": true
  }
}