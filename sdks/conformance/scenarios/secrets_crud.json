{
  "id": "secrets_crud",
  "description": "set, list and remove a secret; values are never returned",
  "capabilities": ["lifecycle", "secrets"],
  "steps": [
    {
      "expect": { "type": "secret_set", "name": "box", "key": "API_KEY", "value": "s3cr3t" },
      "respond": { "type": "ok", "version": "1.0.0" }
    },
    {
      "expect": { "type": "secret_list", "name": "box" },
      "respond": { "type": "secrets", "secrets": [{ "key": "API_KEY", "value": null }] }
    },
    {
      "expect": { "type": "secret_remove", "name": "box", "key": "API_KEY" },
      "respond": { "type": "ok", "version": "1.0.0" }
    }
  ],
  "assert": {
    "set_acked": true,
    "secrets_contain": ["API_KEY"],
    "secret_values_redacted": true,
    "remove_acked": true
  }
}